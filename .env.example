# Resend Email Configuration (REST API over HTTPS Port 443 — Render & Cloud Compatible)
# Sign up at https://resend.com and get your API key from API Keys menu
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=re_your_api_key_here
APP_MAIL_ENABLED=true
APP_MAIL_FROM=onboarding@resend.dev

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Application Frontend Base URL
APP_BASE_URL=https://divvyww.netlify.app